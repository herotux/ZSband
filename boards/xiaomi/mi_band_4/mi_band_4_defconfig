# Enable MPU
CONFIG_ARM_MPU=y

# Enable HW stack protection
CONFIG_HW_STACK_PROTECTION=y

# Enable console over segger RTT
CONFIG_USE_SEGGER_RTT=y
CONFIG_RTT_CONSOLE=y
CONFIG_CONSOLE=y

# Enable GPIO
CONFIG_GPIO=y

# Enable UART
CONFIG_SERIAL=y

# Disable Hex build
CONFIG_BUILD_OUTPUT_HEX=n

# Link application into the DTS-defined image-0 slot, not the product-header area.
CONFIG_USE_DT_CODE_PARTITION=y

